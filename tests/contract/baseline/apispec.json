  "/api/dual/load": {
   "post": {
    "parameters": [
     {
      "in": "body",
      "name": "body",
      "required": false,
      "schema": {
       "properties": {
        "model_path": {
         "description": "传统pkl路径",
         "type": "string"
        },
        "run_id": {
         "description": "版本化run ID",
         "type": "string"
        },
        "which": {
         "description": "模型指针",
         "enum": [
          "best",
          "latest"
         ],
         "type": "string"
        }
       },
       "type": "object"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "模型加载成功"
     },
     "400": {
      "description": "参数无效或加载失败"
     }
    },
    "summary": "加载 ML 模型",
