    ]
   }
  },
  "/api/health": {
   "get": {
    "responses": {
     "200": {
      "description": "系统健康",
      "schema": {
       "properties": {
        "components": {
         "properties": {
          "capture": {
           "type": "object"
          },
          "database": {
           "type": "object"
          },
          "memory": {
           "type": "object"
          },
          "ml_model": {
           "type": "object"
          },
          "sse": {
           "type": "object"
          }
         },
         "type": "object"
        },
        "status": {
         "enum": [
          "healthy",
          "degraded"
         ],
         "type": "string"
        },
        "timestamp": {
         "type": "string"
        },
        "uptime_seconds": {
         "type": "number"
        }
       },
       "type": "object"
      }
     },
     "503": {
      "description": "系统降级"
     }
    },
    "summary": "系统健康检查",
    "tags": [
     "运维"
    ]
   }
  },
  "/api/model/list": {
   "get": {
    "responses": {
     "200": {
      "description": "模型版本列表",
      "schema": {
       "properties": {
        "count": {
         "type": "integer"
        },
        "runs": {
         "description": "模型版本列表",
         "type": "array"
        },
        "source": {
         "description": "数据来源(registry_json)",
         "type": "string"
        }
       },
       "type": "object"
      }
     }
    },
    "summary": "列出所有已训练的模型版本",
    "tags": [
     "模型管理"
    ]
   }
  },
  "/api/model/train": {
   "post": {
    "parameters": [
     {
      "in": "body",
      "name": "body",
      "required": false,
      "schema": {
       "properties": {
        "balance_method": {
         "default": "smote",
         "description": "均衡方法",
         "enum": [
          "class_weight",
          "smote",
          "oversample",
          "undersample",
          "none"
         ],
         "type": "string"
        },
        "dataset_type": {
         "default": "cicids2017",
         "description": "数据集类型",
         "enum": [
          "cicids2017",
          "nsl_kdd",
          "local"
         ],
         "type": "string"
        },
        "quick": {
         "default": false,
         "description": "快速模式",
         "type": "boolean"
        }
       },
       "type": "object"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "训练已启动"
     },
     "409": {
      "description": "训练已在进行中"
     }
    },
    "summary": "异步启动模型训练",
    "tags": [
     "模型管理"
    ]
   }
  },
  "/api/model/train-status": {
   "get": {
    "responses": {
     "200": {
      "description": "训练状态",
      "schema": {
       "properties": {
        "error": {
         "type": "string"
        },
        "progress": {
         "type": "string"
        },
        "result": {
         "type": "object"
        },
        "running": {
         "type": "boolean"
        }
       },
       "type": "object"
      }
     }
    },
    "summary": "获取模型训练状态",
    "tags": [
     "模型管理"
    ]
   }
  },
  "/api/payload/check": {
   "post": {
    "parameters": [
     {
      "in": "body",
      "name": "body",
      "required": true,
      "schema": {
       "properties": {
        "payload": {
         "description": "待检测的载荷文本",
         "type": "string"
        }
       },
       "required": [
        "payload"
       ],
       "type": "object"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "检测结果",
      "schema": {
       "properties": {
        "alerts": {
         "description": "告警列表",
