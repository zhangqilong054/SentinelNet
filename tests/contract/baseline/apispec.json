        "brute_force_window": {
         "description": "暴力破解时间窗口(秒)",
         "type": "integer"
        },
        "ddos_threshold": {
         "description": "DDoS QPS阈值",
         "type": "integer"
        },
        "lateral_movement_threshold": {
         "description": "横向移动阈值",
         "type": "integer"
        },
        "port_scan_threshold": {
         "description": "端口扫描阈值",
         "type": "integer"
        },
        "syn_flood_threshold": {
         "description": "SYN Flood阈值",
         "type": "integer"
        },
        "udp_flood_threshold": {
         "description": "UDP Flood阈值",
         "type": "integer"
        }
       },
       "type": "object"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "当前配置（GET）或更新结果（POST）"
     },
     "400": {
      "description": "无效 JSON"
     }
    },
    "summary": "获取或更新检测阈值配置",
    "tags": [
     "配置"
    ]
   },
   "post": {
    "parameters": [
     {
      "in": "body",
      "name": "body",
      "required": false,
      "schema": {
       "properties": {
        "brute_force_threshold": {
         "description": "暴力破解阈值",
         "type": "integer"
        },
        "brute_force_window": {
         "description": "暴力破解时间窗口(秒)",
         "type": "integer"
        },
        "ddos_threshold": {
         "description": "DDoS QPS阈值",
         "type": "integer"
        },
        "lateral_movement_threshold": {
         "description": "横向移动阈值",
         "type": "integer"
        },
        "port_scan_threshold": {
         "description": "端口扫描阈值",
         "type": "integer"
        },
        "syn_flood_threshold": {
         "description": "SYN Flood阈值",
         "type": "integer"
        },
        "udp_flood_threshold": {
         "description": "UDP Flood阈值",
         "type": "integer"
        }
       },
       "type": "object"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "当前配置（GET）或更新结果（POST）"
     },
     "400": {
      "description": "无效 JSON"
     }
    },
    "summary": "获取或更新检测阈值配置",
    "tags": [
     "配置"
    ]
   }
  },
  "/api/demo/start": {
   "post": {
    "parameters": [
     {
      "in": "body",
