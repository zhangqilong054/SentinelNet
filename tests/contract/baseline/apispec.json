{
 "basePath": "/",
 "definitions": {},
 "info": {
  "description": "校园网加密流量入侵检测系统 — REST API 文档",
  "title": "SentinelNet API",
  "version": "1.0"
 },
 "paths": {
  "/api/alerts": {
   "get": {
    "parameters": [
     {
      "default": 20,
      "description": "返回条数上限",
      "in": "query",
      "name": "limit",
      "type": "integer"
     },
     {
      "default": 0,
      "description": "偏移量",
      "in": "query",
      "name": "offset",
      "type": "integer"
     },
     {
      "default": "all",
      "description": "级别筛选 (high/medium/low/all)",
      "in": "query",
      "name": "level",
      "type": "string"
     }
    ],
    "responses": {
     "200": {
      "description": "告警列表",
      "schema": {
       "properties": {
        "alerts": {
         "description": "告警记录列表",
         "type": "array"
        },
        "limit": {
         "type": "integer"
        },
        "offset": {
         "type": "integer"
        },
        "total": {
         "description": "符合条件的总数",
         "type": "integer"
        }
       },
       "type": "object"
      }
     }
    },
    "summary": "查询告警列表（支持分页和级别筛选）",
    "tags": [
     "告警"
    ]
   }
  },
  "/api/attack/start": {
   "post": {
    "parameters": [
     {
      "in": "body",
      "name": "body",
      "required": false,
      "schema": {
       "properties": {
        "duration": {
         "5-300)": null,
         "default": 30,
         "description": "持续时间(秒",
         "type": "integer"
        },
        "type": {
         "default": "all",
         "description": "攻击类型",
         "enum": [
          "syn_flood",
          "port_scan",
          "udp_flood",
          "brute_force",
          "lateral",
          "all"
         ],
         "type": "string"
        }
       },
       "type": "object"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "攻击模拟已启动"
     },
     "400": {
      "description": "无效参数"
     },
     "409": {
      "description": "攻击模拟已在运行"
     }
    },
    "summary": "启动攻击模拟",
    "tags": [
     "攻击模拟"
    ]
   }
  },
  "/api/attack/status": {
   "get": {
    "responses": {
     "200": {
      "description": "攻击模拟状态",
      "schema": {
       "properties": {
        "elapsed_seconds": {
         "type": "number"
        },
        "running": {
         "type": "boolean"
        },
        "type": {
         "type": "string"
        }
       },
       "type": "object"
      }
     }
    },
    "summary": "获取攻击模拟状态",
    "tags": [
     "攻击模拟"
    ]
   }
  },
  "/api/attack/stop": {
   "post": {
    "responses": {
     "200": {
      "description": "攻击模拟已停止"
     }
    },
    "summary": "停止攻击模拟",
    "tags": [
     "攻击模拟"
    ]
   }
  },
  "/api/auto/start": {
   "post": {
    "parameters": [
     {
      "in": "body",
      "name": "body",
      "required": false,
      "schema": {
       "properties": {
        "duration": {
         "10-300)": null,
         "default": 30,
         "description": "抓包时长(秒",
         "type": "integer"
        }
       },
       "type": "object"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "全流程已启动",
      "schema": {
       "properties": {
        "duration": {
         "type": "integer"
        },
        "status": {
         "type": "string"
        }
       },
       "type": "object"
      }
     },
     "409": {
      "description": "全流程已在运行"
     }
    },
    "summary": "一键全流程：增强抓包 → 训练 → ML 加载",
    "tags": [
     "一键全流程"
    ]
   }
  },
  "/api/auto/status": {
   "get": {
    "responses": {
     "200": {
      "description": "全流程状态",
      "schema": {
       "properties": {
        "error": {
         "type": "string"
        },
        "message": {
         "type": "string"
        },
        "result": {
         "type": "object"
        },
        "running": {
         "type": "boolean"
        },
        "step": {
         "type": "integer"
        },
        "step_name": {
         "type": "string"
        },
        "total_steps": {
         "type": "integer"
        }
       },
       "type": "object"
      }
     }
    },
    "summary": "查询一键全流程进度",
    "tags": [
     "一键全流程"
    ]
   }
  },
  "/api/capture/enhanced-status": {
   "get": {
    "responses": {
     "200": {
      "description": "增强抓包状态",
      "schema": {
       "properties": {
        "duration": {
         "type": "integer"
        },
        "error": {
         "type": "string"
        },
        "flows": {
         "type": "integer"
        },
        "packets": {
         "type": "integer"
        },
        "running": {
         "type": "boolean"
        },
        "status": {
         "type": "string"
        }
       },
       "type": "object"
      }
     }
    },
    "summary": "查询增强抓包状态",
    "tags": [
     "增强抓包"
    ]
   }
  },
  "/api/capture/start": {
   "post": {
    "responses": {
     "200": {
      "description": "抓包已启动"
     }
    },
    "summary": "启动网络抓包",
    "tags": [
     "抓包控制"
    ]
   }
  },
  "/api/capture/start-enhanced": {
   "post": {
    "parameters": [
     {
      "in": "body",
      "name": "body",
      "required": false,
      "schema": {
       "properties": {
        "duration": {
         "10-600)": null,
         "default": 60,
         "description": "抓包时长(秒",
         "type": "integer"
        }
       },
       "type": "object"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "增强抓包已启动",
      "schema": {
       "properties": {
        "duration": {
         "type": "integer"
        },
        "status": {
         "type": "string"
        }
       },
       "type": "object"
      }
     },
     "409": {
      "description": "增强抓包已在运行"
     }
    },
    "summary": "启动增强抓包（18维流特征 + TLS 分析）",
    "tags": [
     "增强抓包"
    ]
   }
  },
  "/api/capture/status": {
   "get": {
    "responses": {
     "200": {
      "description": "抓包状态",
      "schema": {
       "properties": {
        "running": {
         "description": "是否正在抓包",
         "type": "boolean"
        }
       },
       "type": "object"
      }
     }
    },
    "summary": "查询抓包状态",
    "tags": [
     "抓包控制"
    ]
   }
  },
  "/api/capture/stop": {
   "post": {
    "responses": {
     "200": {
      "description": "抓包已停止"
     }
    },
    "summary": "停止网络抓包",
    "tags": [
     "抓包控制"
    ]
   }
  },
  "/api/capture/stop-enhanced": {
   "post": {
    "responses": {
     "200": {
      "description": "增强抓包已停止"
     }
    },
    "summary": "停止增强抓包",
    "tags": [
     "增强抓包"
    ]
   }
  },
  "/api/check": {
   "get": {
    "responses": {
     "200": {
      "description": "环境检查结果",
      "schema": {
       "properties": {
        "capture": {
         "type": "object"
        },
        "data_files": {
         "type": "object"
        },
        "dependencies": {
         "type": "object"
        },
        "model_files": {
         "type": "object"
        },
        "ok": {
         "description": "整体是否通过",
         "type": "boolean"
        },
        "python": {
         "type": "object"
        }
       },
       "type": "object"
      }
     }
    },
    "summary": "环境自检：Python 版本、依赖包、Npcap、模型文件、数据文件",
    "tags": [
     "环境自检"
    ]
   }
  },
  "/api/cleanup": {
   "post": {
    "parameters": [
     {
      "in": "body",
      "name": "body",
      "required": false,
      "schema": {
       "properties": {
        "days": {
         "default": 7,
         "description": "保留最近N天的数据",
         "type": "integer"
        }
       },
       "type": "object"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "清理结果"
     }
    },
    "summary": "清理过期历史数据",
    "tags": [
     "数据管理"
    ]
   }
  },
  "/api/config": {
   "get": {
    "parameters": [
     {
      "in": "body",
      "name": "body",
      "required": false,
      "schema": {
       "properties": {
        "brute_force_threshold": {
         "description": "暴力破解阈值",
