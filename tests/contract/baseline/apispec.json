        },
        "is_anomaly": {
         "description": "是否异常",
         "type": "boolean"
        },
        "payload_length": {
         "description": "载荷长度",
         "type": "integer"
        }
       },
       "type": "object"
      }
     },
     "400": {
      "description": "参数无效"
     }
    },
    "summary": "应用层载荷检测（SQL 注入 / XSS）",
    "tags": [
     "载荷检测"
    ]
   }
  },
  "/api/save": {
   "post": {
    "responses": {
