{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:baseline": "playwright test -g 视觉基线 --update-snapshots",
    "generate-api": "openapi-typescript ../openapi_new.json -o src/types/api-generated.d.ts",
    "typecheck": "vue-tsc -b --noEmit"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "echarts": "^5.6.0",
    "element-plus": "^2.14.5",
    "pinia": "^4.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vue": "^3.5.42",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
