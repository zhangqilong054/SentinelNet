# SentinelNet 哨兵网络 — 环境变量配置示例
# 复制此文件为 .env 并修改配置值
# cp .env.example .env

# ── 基础配置 ──────────────────────────────────────────────
# 开发模式（1=允许默认 secret_key 等不安全默认值，仅限本地开发；
# 生产环境必须保持 0 并设置强随机的 CAMPUS_IDS_SECRET_KEY）
CAMPUS_IDS_DEBUG=0

# 监听端口
CAMPUS_IDS_WEB_PORT=5000

# 刷新间隔（毫秒）—— 新名 WEB_REFRESH_INTERVAL_MS 与旧名 REFRESH_MS 等价
CAMPUS_IDS_WEB_REFRESH_INTERVAL_MS=2000
# CAMPUS_IDS_REFRESH_MS=2000

# ── 安全配置 ──────────────────────────────────────────────
# API Token 认证（设置后启用 API 认证，留空禁用）
# ⚠️ 注意：CAMPUS_IDS_AUTH_ENABLED=1 仅在 CAMPUS_IDS_API_TOKEN 非空时生效，
# 若 API_TOKEN 为空则认证自动关闭（无论 AUTH_ENABLED 设置为何值）
CAMPUS_IDS_API_TOKEN=

# 是否启用 API 认证（1=启用，0=禁用）
CAMPUS_IDS_AUTH_ENABLED=1

# 会话密钥（CSRF 签名与登录会话；生产环境必须修改！
# 非 DEBUG 启动时若仍为默认值将拒绝启动；docker compose 已强制注入）
CAMPUS_IDS_SECRET_KEY=sentinelnet-dev-secret-key-change-in-prod

# CORS 允许来源（逗号分隔或 JSON 数组均可）
# 留空 = 仅同源；删除本行 = 默认 ["*"]（允许全部来源，仅限开发）
CAMPUS_IDS_CORS_ORIGINS=

# ── 检测阈值 ──────────────────────────────────────────────
# DDoS 检测阈值（QPS）
CAMPUS_IDS_DDOS_THRESHOLD=500

# 端口扫描检测阈值
CAMPUS_IDS_PORT_SCAN_THRESHOLD=50

# SYN Flood 检测阈值
CAMPUS_IDS_SYN_FLOOD_THRESHOLD=100

# UDP Flood 检测阈值
CAMPUS_IDS_UDP_FLOOD_THRESHOLD=200

# 暴力破解检测阈值 —— 新名 BRUTE_FORCE_THRESHOLD 与旧名 BF_THRESHOLD 等价
CAMPUS_IDS_BRUTE_FORCE_THRESHOLD=10
# CAMPUS_IDS_BF_THRESHOLD=10

# 暴力破解时间窗口（秒）—— 新名 BRUTE_FORCE_WINDOW 与旧名 BF_WINDOW 等价
CAMPUS_IDS_BRUTE_FORCE_WINDOW=60
# CAMPUS_IDS_BF_WINDOW=60

# 暴力破解敏感端口（逗号分隔）
CAMPUS_IDS_BRUTE_FORCE_PORTS=22,21,3389,25,3306,5432

# 横向移动检测阈值 —— 新名 LATERAL_MOVEMENT_THRESHOLD 与旧名 LATERAL_THRESHOLD 等价
CAMPUS_IDS_LATERAL_MOVEMENT_THRESHOLD=5
# CAMPUS_IDS_LATERAL_THRESHOLD=5

# ── 数据与日志路径 ────────────────────────────────────────
# 数据目录（模型、CSV 等文件所在目录，默认项目根目录）
CAMPUS_IDS_DATA_DIR=
# 日志目录（默认项目根目录/logs）
CAMPUS_IDS_LOG_DIR=

# ── 滑动窗口与告警 ────────────────────────────────────────
# 滑动窗口大小（秒）
CAMPUS_IDS_WINDOW_SIZE=60
# 告警 API 返回上限 —— 新名 MAX_ALERT_API_RETURN 与旧名 MAX_ALERT_API 等价
CAMPUS_IDS_MAX_ALERT_API_RETURN=20
# CAMPUS_IDS_MAX_ALERT_API=20
# 数据自动清理保留天数（告警与流量记录）
CAMPUS_IDS_CLEANUP_DAYS=30
# 高频 IP 阈值
CAMPUS_IDS_HIGH_FREQ_IP_THRESHOLD=50

# ── ML 检测配置 ──────────────────────────────────────────
# ML 检测间隔（秒）—— 新名 ML_INTERVAL_SEC 与旧名 ML_INTERVAL 等价
CAMPUS_IDS_ML_INTERVAL_SEC=5.0
# CAMPUS_IDS_ML_INTERVAL=5.0
# ML 流缓冲区大小 —— 新名 ML_FLOW_BUFFER_SIZE 与旧名 ML_FLOW_BUFFER 等价
CAMPUS_IDS_ML_FLOW_BUFFER_SIZE=10000
# CAMPUS_IDS_ML_FLOW_BUFFER=10000
# ML 历史记录大小 —— 新名 ML_HISTORY_SIZE 与旧名 ML_HISTORY 等价
CAMPUS_IDS_ML_HISTORY_SIZE=60
# CAMPUS_IDS_ML_HISTORY=60
# ML 高置信阈值（双引擎融合）
CAMPUS_IDS_ML_CONF_HIGH=0.7
# ML 低置信阈值（双引擎融合）
CAMPUS_IDS_ML_CONF_LOW=0.3

# ── TLS 与训练 ───────────────────────────────────────────
# TLS 分析器记录上限
CAMPUS_IDS_TLS_RECORD_MAX=10000
# TLS 检测端口（逗号分隔）
CAMPUS_IDS_TLS_PORTS=443,8443
# DNS 检测端口
CAMPUS_IDS_DNS_PORT=53
# 最小训练样本数
CAMPUS_IDS_MIN_TRAIN_SAMPLES=100

# ── Web 前端模式 ──────────────────────────────────────────
# 前端模式：new=Vue3 SPA / legacy=Jinja2 模板（默认 legacy）
# 2026-09-19 起本变量已收编进 Settings，写入 .env 同样生效；
# （此前仅真实环境变量/docker compose environment 有效）
CAMPUS_IDS_FRONTEND=legacy
